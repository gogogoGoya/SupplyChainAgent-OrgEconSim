# Unified runtime environment template for SupplyChainAgent.
# Copy this file to scripts/.env on your operator host and fill real values there.
# Visitor mode ignores this file. Enable execution explicitly in the shell with
# SUPPLY_CHAIN_PLATFORM_MODE=operator and a private SUPPLY_CHAIN_OPERATOR_TOKEN
# of at least 32 characters; these two settings are never loaded from this file.

# Optional path overrides. Leave empty to derive both roots from this repository.
SUPPLY_CHAIN_PROJECT_ROOT=
SUPPLY_CHAIN_AGENT_ROOT=

# Simulation service endpoint used by StaticUtils / MultiTenantUtils.
SIMULATION_API_BASE_URL=

# Optional local operations / SQL mirror database path. Relative paths are
# resolved from the project root; leaving these empty uses the same default.
SIMULATION_SQL_MIRROR_PATH=
SIMULATION_OPERATIONS_SQLITE_PATH=

# Agent Environment / model gateway settings used by Claude Agent SDK.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_LIST=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
NO_PROXY=
